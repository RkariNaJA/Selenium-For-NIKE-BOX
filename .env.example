# Copy this file to ".env" and fill in your real values.
# The real .env is gitignored and must NEVER be committed.

# Box login (used by main.py)
BOX_EMAIL=your.email@example.com
BOX_PASSWORD=your-password

# Flow paths and script list (adjust to your machine)
BOX-FLOW_BASE_PATH=D:\path\to\Selenium For BOX
BOX_FOLDER_PATH=D:\path\to\Selenium For BOX\Download
BOX_SSIS_PATH=D:\path\to\Package.dtsx
BOX-FLOW_SCRIPTS="main.py, CombineFile.py"

# Optional
BOX-FLOW_RUN_ID=BOX-FLOW_DEFAULT
BOX-FLOW_LOG_FILE=flow_Log.txt
# DESKTOP_PATH=C:\Users\you\Desktop
